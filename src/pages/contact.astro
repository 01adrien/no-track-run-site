---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { MAX_MESSAGE_LENGTH } from "@/constants";
import "@/styles/contact.css";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="NoTrackRun — Contact">
  <Header page="contact" />

  <!-- HERO -->
  <section class="hero-bg text-center py-24 px-6 relative">
    <div class="max-w-2xl mx-auto">
      <h1
        class="text-6xl font-extrabold leading-none mb-6 fade-in fade-delay-1"
      >
        {t("contact.hero.title")}
      </h1>
      <p class="text-lg fade-in fade-delay-2 text-muted">
        {t("contact.hero.subtitle")}
      </p>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="product-section" style="padding-top: 2rem">
    <div class="max-w-xl mx-auto px-6">
      <form id="contact-form" class="card p-8 fade-in" novalidate>
        <div class="form-row mb-4">
          <div>
            <label class="form-label" for="name">{t("form.name")}</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder={t("form.name.placeholder")}
              autocomplete="name"
              maxlength="200"
              required
            />
            <span class="field-error" id="name-error"></span>
          </div>
          <div>
            <label class="form-label" for="email">{t("form.email")}</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder={t("form.email.placeholder")}
              autocomplete="email"
              maxlength="254"
              required
            />
            <span class="field-error" id="email-error"></span>
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label" for="role">{t("form.role")}</label>
          <select id="role" name="role" autocomplete="off">
            <option value="runner">{t("form.role.runner")}</option>
            <option value="coach">{t("form.role.coach")}</option>
            <option value="company">{t("form.role.company")}</option>
            <option value="other">{t("form.role.other")}</option>
          </select>
        </div>

        <div class="mb-4">
          <label class="form-label" for="organization"
            >{t("form.organization")}</label
          >
          <input
            type="text"
            id="organization"
            name="organization"
            placeholder={t("form.organization.placeholder")}
            autocomplete="organization"
            maxlength="200"
          />
        </div>

        <div class="mb-2">
          <label class="form-label" for="message">
            {t("form.message")}
            <span class="char-counter" id="message-counter" aria-hidden="true"
              >0 / {MAX_MESSAGE_LENGTH}</span
            >
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            maxlength={MAX_MESSAGE_LENGTH}
            placeholder={t("form.message.placeholder")}
            required></textarea>
          <span class="field-error" id="message-error"></span>
        </div>

        <!-- Honeypot -->
        <div class="hp-field" aria-hidden="true">
          <label for="website">Website</label>
          <input
            type="text"
            id="website"
            name="website"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <button
          type="submit"
          class="btn-primary form-submit py-4 text-base text-center w-full mt-4"
        >
          {t("form.submit")}
        </button>

        <div id="form-status" class="form-status" role="alert"></div>
      </form>
    </div>
  </section>

  <Footer />

  <!-- Traductions des messages geres cote client (validation, statuts) -->
  <script
    type="application/json"
    id="i18n-form-data"
    set:html={JSON.stringify({
      errorName: t("form.error.name"),
      errorEmail: t("form.error.email"),
      errorMessage: t("form.error.message"),
      errorInvalid: t("form.error.invalid"),
      errorGeneric: t("form.error.generic"),
      errorNetwork: t("form.error.network"),
      success: t("form.success"),
      sending: t("form.submit.sending"),
      submitLabel: t("form.submit"),
      maxMessageLength: MAX_MESSAGE_LENGTH,
    })}
  />
</Layout>

<script>
  const i18nData = JSON.parse(
    document.getElementById("i18n-form-data")!.textContent!
  );
  const form = document.getElementById(
    "contact-form"
  ) as HTMLFormElement | null;

  if (form) {
    const status = document.getElementById("form-status") as HTMLElement;
    const submitBtn = form.querySelector(".form-submit") as HTMLButtonElement;
    const messageField = form.elements.namedItem(
      "message"
    ) as HTMLTextAreaElement;
    const messageCounter = document.getElementById(
      "message-counter"
    ) as HTMLElement;
    const MAX_MESSAGE_LENGTH: number = i18nData.maxMessageLength;

    const rules: Record<
      string,
      { validate: (v: string) => boolean; message: string }
    > = {
      name: {
        validate: (v) => v.trim().length > 0 && v.trim().length <= 200,
        message: i18nData.errorName,
      },
      email: {
        validate: (v) =>
          /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) && v.trim().length <= 254,
        message: i18nData.errorEmail,
      },
      message: {
        validate: (v) =>
          v.trim().length > 0 && v.trim().length <= MAX_MESSAGE_LENGTH,
        message: i18nData.errorMessage,
      },
    };

    function setFieldState(
      field: HTMLInputElement | HTMLTextAreaElement,
      isValid: boolean
    ) {
      const errorEl = document.getElementById(field.name + "-error");
      field.classList.toggle("invalid", !isValid);
      field.setAttribute("aria-invalid", String(!isValid));
      if (errorEl) {
        errorEl.textContent = isValid ? "" : rules[field.name].message;
        errorEl.classList.toggle("visible", !isValid);
        if (!isValid) {
          field.setAttribute("aria-describedby", errorEl.id);
        } else {
          field.removeAttribute("aria-describedby");
        }
      }
    }

    function validateField(field: HTMLInputElement | HTMLTextAreaElement) {
      const rule = rules[field.name];
      if (!rule) return true;
      const isValid = rule.validate(field.value);
      setFieldState(field, isValid);
      return isValid;
    }

    function validateForm() {
      let allValid = true;
      ["name", "email", "message"].forEach((fieldName) => {
        const field = form!.elements.namedItem(fieldName) as
          | HTMLInputElement
          | HTMLTextAreaElement;
        if (!validateField(field)) allValid = false;
      });
      return allValid;
    }

    ["name", "email", "message"].forEach((fieldName) => {
      const field = form.elements.namedItem(fieldName) as
        | HTMLInputElement
        | HTMLTextAreaElement;
      field.addEventListener("input", () => {
        if (field.classList.contains("invalid")) validateField(field);
      });
    });

    function updateCounter() {
      const len = messageField.value.length;
      messageCounter.textContent = `${len} / ${MAX_MESSAGE_LENGTH}`;
      messageCounter.classList.toggle(
        "near-limit",
        len >= MAX_MESSAGE_LENGTH * 0.9 && len < MAX_MESSAGE_LENGTH
      );
      messageCounter.classList.toggle("at-limit", len >= MAX_MESSAGE_LENGTH);
    }
    messageField.addEventListener("input", updateCounter);
    updateCounter();

    function showStatus(kind: "success" | "error", msg: string) {
      status.textContent = msg;
      status.className = "form-status visible " + kind;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      status.className = "form-status";

      if (!validateForm()) {
        showStatus("error", i18nData.errorInvalid);
        (form.querySelector(".invalid") as HTMLElement | null)?.focus();
        return;
      }

      const websiteField = form.elements.namedItem(
        "website"
      ) as HTMLInputElement;
      if (websiteField.value.trim() !== "") {
        showStatus("success", i18nData.success);
        form.reset();
        updateCounter();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = i18nData.sending;

      try {
        const res = await fetch("/contact.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: (
              form.elements.namedItem("name") as HTMLInputElement
            ).value.trim(),
            email: (
              form.elements.namedItem("email") as HTMLInputElement
            ).value.trim(),
            role: (form.elements.namedItem("role") as HTMLSelectElement).value,
            organization: (
              form.elements.namedItem("organization") as HTMLInputElement
            ).value.trim(),
            message: messageField.value.trim(),
            website: websiteField.value,
          }),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          showStatus("success", i18nData.success);
          form.reset();
          updateCounter();
        } else {
          showStatus("error", data.error || i18nData.errorGeneric);
        }
      } catch (err) {
        console.log(err);
        showStatus("error", i18nData.errorNetwork);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = i18nData.submitLabel;
      }
    });
  }
</script>
