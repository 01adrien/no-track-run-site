---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HeroSimple from "@/components/HeroSimple.astro";
import SectionHowItWorks from "@/components/SectionHowItWorks.astro";
import SectionData from "@/components/SectionData.astro";
import SectionFormulas from "@/components/SectionFormulas.astro";
import SectionFaq from "@/components/SectionFaq.astro";
import SectionTeam from "@/components/SectionTeam.astro";
import * as en from "@/content/about";
import * as fr from "@/content/about.fr";
import * as nl from "@/content/about.nl";
import { getLangFromUrl } from "@/i18n/utils";
import "@/styles/about.css";

const lang = getLangFromUrl(Astro.url);
const contentByLang = { en, fr, nl };
const content = contentByLang[lang];
const {
  heroAbout,
  howItWorks,
  steps,
  dataSection,
  dataOnDevice,
  dataOnServer,
  dataNote,
  formulasSection,
  formulas,
  faqSection,
  faqs,
  teamSection,
  team,
} = content;
---

<Layout title={`NoTrackRun — ${heroAbout.titleLines.join(" ")}`}>
  <Header page="about" />

  <HeroSimple size="large" subtitle={heroAbout.subtitle}>
    {
      heroAbout.titleLines.map((line, i) => (
        <>
          {line}
          {i < heroAbout.titleLines.length - 1 && <br />}
        </>
      ))
    }
  </HeroSimple>

  <SectionHowItWorks
    tag={howItWorks.tag}
    heading={howItWorks.heading}
    intro={howItWorks.intro}
    steps={steps}
  />

  <SectionData
    tag={dataSection.tag}
    heading={dataSection.heading}
    intro={dataSection.intro}
    onDevice={dataOnDevice}
    onServer={dataOnServer}
    note={dataNote}
  />

  <SectionFormulas
    tag={formulasSection.tag}
    heading={formulasSection.heading}
    intro={formulasSection.intro}
    formulas={formulas}
    ctaLabel={formulasSection.ctaLabel}
    ctaHref="#faq"
  />

  <SectionFaq tag={faqSection.tag} heading={faqSection.heading} faqs={faqs} />

  <SectionTeam
    tag={teamSection.tag}
    heading={teamSection.heading}
    intro={teamSection.intro}
    members={team}
  />

  <Footer />
</Layout>
