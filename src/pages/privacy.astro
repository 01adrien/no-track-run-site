---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LegalContent from "@/components/LegalContent.astro";
import * as en from "@/content/legal";
import * as fr from "@/content/legal.fr";
import * as nl from "@/content/legal.nl";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const contentByLang = { en, fr, nl };
const { privacyPolicy } = contentByLang[lang];
---

<Layout title={`NoTrackRun — ${privacyPolicy.title}`}>
  <Header page="other" />
  <LegalContent doc={privacyPolicy} />
  <Footer />
</Layout>
