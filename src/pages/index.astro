---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HeroHome from "@/components/HeroHome.astro";
import SectionWeb from "@/components/SectionWeb.astro";
import SectionMobile from "@/components/SectionMobile.astro";
import SectionWatch from "@/components/SectionWatch.astro";
import SectionReviews from "@/components/SectionReviews.astro";
import SectionPhilosophy from "@/components/SectionPhilosophy.astro";
import { webScreenshots, mobileScreenshots, watchMockups } from "@/content/media";
import * as en from "@/content/home";
import * as fr from "@/content/home.fr";
import * as nl from "@/content/home.nl";
import { getLangFromUrl } from "@/i18n/utils";
import "@/styles/index.css";

const lang = getLangFromUrl(Astro.url);
const contentByLang = { en, fr, nl };
const content = contentByLang[lang];
const { heroHome, webCopy, mobileCopy, watchCopy, reviewsCopy, philosophyCopy, testimonials, philosophyCells } = content;
---

<Layout title={`NoTrackRun — ${heroHome.title}`}>
  <Header page="home" />

  <HeroHome
    badge={heroHome.badge}
    subtitle={heroHome.subtitle}
    ctas={[
      { label: heroHome.ctaPrimary, href: "#web", variant: "primary" },
      { label: heroHome.ctaSecondary, href: "#philosophy", variant: "ghost" },
    ]}
  >
    {heroHome.title}
  </HeroHome>

  <SectionWeb screenshots={webScreenshots} copy={webCopy} />
  <SectionMobile screenshots={mobileScreenshots} copy={mobileCopy} />
  <SectionWatch mockups={watchMockups} copy={watchCopy} />

  <!-- <SectionReviews
    id="avis"
    tag={reviewsCopy.tag}
    heading={reviewsCopy.heading}
    intro={reviewsCopy.intro}
    testimonials={testimonials}
  /> -->

  <SectionPhilosophy
    id="philosophy"
    tag={philosophyCopy.tag}
    intro={philosophyCopy.intro}
    cells={philosophyCells}
    quote={philosophyCopy.quote}
    quoteAuthor={philosophyCopy.quoteAuthor}
  >
    <Fragment slot="heading">{philosophyCopy.headingLine1}<br />{philosophyCopy.headingLine2}</Fragment>
  </SectionPhilosophy>

  <Footer />
</Layout>
