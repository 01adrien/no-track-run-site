---
import type { FormulaPlan } from "@/types";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  tag: string;
  heading: string;
  intro: string;
  formulas: FormulaPlan[];
  ctaLabel: string;
  ctaHref: string;
  addOnsNote?: string;
}
const { tag, heading, intro, formulas, ctaLabel, ctaHref, addOnsNote } =
  Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="formulas" class="product-section">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-14 fade-in">
      <div class="section-tag">{tag}</div>
      <h2 class="text-4xl font-bold mb-4">{heading}</h2>
      <p class="mx-auto max-w-[560px] text-muted">{intro}</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {
        formulas.map((formula) => (
          <div
            class="card formula-card p-8 fade-in fade-delay-1"
            style="border-color: hsl(67 100% 51% / 0.4)"
          >
            <div>
              <div class="pill" style="margin-bottom: 0.5rem">
                {formula.name}
              </div>
              <div class="price">
                {formula.price} € <span>{t("formulas.perMonth")}</span>
              </div>
            </div>
            <ul>
              <li>{t("formulas.seatsLabel").replace("{n}", formula.seats)}</li>
              <li>
                {t("formulas.tokensLabel").replace("{n}", formula.tokens)}
              </li>
            </ul>
            <a href={ctaHref} class="btn-primary text-center py-3">
              {ctaLabel}
            </a>
          </div>
        ))
      }
    </div>

    {
      addOnsNote && (
        <p class="text-center text-muted mt-8 text-sm">{addOnsNote}</p>
      )
    }
  </div>
</section>
