---
import Carousel from "./Carousel.astro";
import TestimonialCard from "./TestimonialCard.astro";
import type { Testimonial } from "@/types";

interface Props {
  id: string;
  tag: string;
  heading: string;
  intro: string;
  testimonials: Testimonial[];
  perSlide?: number;
}
const { id, tag, heading, intro, testimonials, perSlide = 3 } = Astro.props;

// Regroupe les temoignages en paquets de `perSlide` pour former les slides du carousel
const groups: Testimonial[][] = [];
for (let i = 0; i < testimonials.length; i += perSlide) {
  groups.push(testimonials.slice(i, i + perSlide));
}
---

<section
  id={id}
  class="product-section"
  style="background: radial-gradient(ellipse 60% 50% at 0% 50%, hsl(67 100% 44% / 0.05) 0%, transparent 60%);"
>
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12 fade-in">
      <div class="section-tag">{tag}</div>
      <h2 class="text-5xl font-bold mb-4">{heading}</h2>
      <p class="text-lg mx-auto max-w-[560px] text-muted">{intro}</p>
    </div>

    <div class="fade-in fade-delay-1">
      <Carousel>
        {
          groups.map((group) => (
            <div class="carousel-slide">
              <div class="grid md:grid-cols-3 gap-5">
                {group.map((t) => (
                  <TestimonialCard stars={t.stars} name={t.name} role={t.role} initials={t.initials}>
                    {t.quote}
                  </TestimonialCard>
                ))}
              </div>
            </div>
          ))
        }
      </Carousel>
    </div>
  </div>
</section>
