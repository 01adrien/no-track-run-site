---
interface Props {
  stars?: string;
  name: string;
  role: string;
  initials: string;
}
const { stars = "★★★★★", name, role, initials } = Astro.props;
---

<div class="testimonial-card">
  <div class="testimonial-stars">{stars}</div>
  <p class="testimonial-quote"><slot /></p>
  <div class="flex items-center gap-3">
    <div class="testimonial-avatar">{initials}</div>
    <div>
      <div class="font-semibold text-sm">{name}</div>
      <div class="text-xs" style="color: var(--muted-foreground)">{role}</div>
    </div>
  </div>
</div>
