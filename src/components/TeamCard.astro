---
interface Props {
  name: string;
  role: string;
  bio: string;
  initials?: string;
}
const { name, role, bio, initials = "?" } = Astro.props;
---

<div class="card team-card">
  <div class="team-avatar">{initials}</div>
  <h4>{name}</h4>
  <div class="role">{role}</div>
  <div class="bio">{bio}</div>
</div>
