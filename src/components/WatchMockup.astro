---
import type { WatchMockupData } from "@/types";

type Props = WatchMockupData;

const { label, variant, value, sub, linePath, ringPercent = 0 } = Astro.props;

const CIRCUMFERENCE = 2 * Math.PI * 26;
const filled = (ringPercent / 100) * CIRCUMFERENCE;
---

<div
  class="img-placeholder"
  style="height: 340px; border-style: solid; display:flex; align-items:center; justify-content:center;"
>
  <svg viewBox="0 0 200 240" style="width: 150px; height: 180px">
    <rect x="55" y="10" width="14" height="24" rx="4" fill="var(--muted)"
    ></rect>
    <rect x="131" y="10" width="14" height="24" rx="4" fill="var(--muted)"
    ></rect>
    <rect x="55" y="206" width="14" height="24" rx="4" fill="var(--muted)"
    ></rect>
    <rect x="131" y="206" width="14" height="24" rx="4" fill="var(--muted)"
    ></rect>
    <rect
      x="20"
      y="30"
      width="160"
      height="180"
      rx="28"
      fill="var(--card)"
      stroke="var(--border)"
      stroke-width="2"></rect>
    <rect
      x="34"
      y="44"
      width="132"
      height="152"
      rx="16"
      fill="var(--background)"></rect>

    <text
      x="100"
      y="90"
      text-anchor="middle"
      fill="var(--muted-foreground)"
      font-family="Syne, sans-serif"
      font-size="11"
      letter-spacing="1"
    >
      {label}
    </text>

    {
      variant === "line" && (
        <>
          <text
            x="100"
            y="130"
            text-anchor="middle"
            fill="var(--accent)"
            font-family="Syne, sans-serif"
            font-size="30"
            font-weight="800"
          >
            {value}
          </text>
          <text
            x="100"
            y="150"
            text-anchor="middle"
            fill="var(--muted-foreground)"
            font-family="DM Sans, sans-serif"
            font-size="11"
          >
            {sub}
          </text>
          <path
            d={linePath}
            fill="none"
            stroke="var(--accent)"
            stroke-width="2"
            opacity="0.7"
          />
        </>
      )
    }

    {
      variant === "ring" && (
        <>
          <circle
            cx="100"
            cy="128"
            r="26"
            fill="none"
            stroke="var(--muted)"
            stroke-width="6"
          />
          <circle
            cx="100"
            cy="128"
            r="26"
            fill="none"
            stroke="var(--accent)"
            stroke-width="6"
            stroke-dasharray={`${filled} ${CIRCUMFERENCE - filled}`}
            stroke-linecap="round"
            transform="rotate(-90 100 128)"
          />
          <text
            x="100"
            y="133"
            text-anchor="middle"
            fill="var(--foreground)"
            font-family="Syne, sans-serif"
            font-size="13"
            font-weight="700"
          >
            {value}
          </text>
          <text
            x="100"
            y="172"
            text-anchor="middle"
            fill="var(--muted-foreground)"
            font-family="DM Sans, sans-serif"
            font-size="10"
          >
            {sub}
          </text>
        </>
      )
    }
  </svg>
</div>
