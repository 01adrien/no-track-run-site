---
import type { Cta } from "@/types";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  badge: string;
  subtitle: string;
  ctas: Cta[];
}
const { badge, subtitle, ctas } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero-bg text-center py-36 px-6 relative">
  <div class="max-w-4xl mx-auto">
    <div class="hero-badge fade-in">● {badge}</div>
    <h1 class="text-7xl md:text-8xl leading-none mb-6 fade-in fade-delay-1">
      <slot />
    </h1>
    <p
      class="text-lg md:text-xl max-w-2xl mx-auto mb-10 fade-in fade-delay-2 text-muted"
    >
      {subtitle}
    </p>
    <div class="flex flex-wrap gap-4 justify-center fade-in fade-delay-3">
      {
        ctas.map((cta) => (
          <a
            href={cta.href}
            class={
              cta.variant === "primary"
                ? "btn-primary px-8 py-4 text-base"
                : "btn-ghost px-8 py-4 text-base"
            }
          >
            {cta.label}
          </a>
        ))
      }
    </div>
  </div>
</section>
