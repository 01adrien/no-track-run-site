---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="carousel">
  <div class="carousel-track">
    <slot />
  </div>
  <div class="carousel-controls">
    <button class="carousel-btn" data-dir="-1" aria-label={t("carousel.prev")}
      >‹</button
    >
    <div class="carousel-dots"></div>
    <button class="carousel-btn" data-dir="1" aria-label={t("carousel.next")}
      >›</button
    >
  </div>
</div>

<script>
  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>(".carousel-track");
    const slides = Array.from(
      root.querySelectorAll<HTMLElement>(".carousel-slide")
    );
    const dotsContainer = root.querySelector<HTMLElement>(".carousel-dots");
    if (!track || !dotsContainer || slides.length === 0) return;

    let index = 0;

    slides.forEach((_, i) => {
      const dot = document.createElement("div");
      dot.className = "carousel-dot" + (i === 0 ? " active" : "");
      dot.addEventListener("click", () => goTo(i));
      dotsContainer.appendChild(dot);
    });

    function goTo(i: number) {
      index = (i + slides.length) % slides.length;
      track!.style.transform = `translateX(-${index * 100}%)`;
      dotsContainer!
        .querySelectorAll(".carousel-dot")
        .forEach((d, j) => d.classList.toggle("active", j === index));
    }

    root.querySelectorAll<HTMLButtonElement>(".carousel-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const dir = Number(btn.dataset.dir);
        goTo(index + dir);
      });
    });
  }

  document.querySelectorAll<HTMLElement>(".carousel").forEach(initCarousel);
</script>
