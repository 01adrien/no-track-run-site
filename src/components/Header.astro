---
import {
  getLangFromUrl,
  useTranslations,
  localizePath,
  getAlternatePath,
} from "@/i18n/utils";
import { languages } from "@/i18n/ui";

interface Props {
  page: "home" | "about" | "contact" | "other";
}
const { page } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localeList = Object.keys(languages) as (keyof typeof languages)[];

const links = [
  { href: localizePath("/", lang), label: t("nav.home"), key: "home" },
  { href: localizePath("/about", lang), label: t("nav.about"), key: "about" },
  {
    href: localizePath("/contact", lang),
    label: t("nav.contact"),
    key: "contact",
  },
];
---

<header>
  <div class="flex justify-between items-center px-8 py-5">
    <a
      href={localizePath("/", lang)}
      class="text-xl font-bold tracking-tight"
      style="font-family: 'Syne', sans-serif"
    >
      NoTrack<span style="color: var(--accent)">Run</span>
    </a>

    <nav class="hidden md:flex items-center gap-8 text-sm text-muted">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "hover:text-white transition",
              { "nav-active": l.key === page },
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <span class="nav-divider" aria-hidden="true"></span>

      <div class="locale-pill">
        {
          localeList.map((l) =>
            l === lang ? (
              <span class="locale-active">{l}</span>
            ) : (
              <a href={getAlternatePath(Astro.url, lang, l)}>{l}</a>
            )
          )
        }
      </div>
    </nav>

    <div class="flex items-center gap-3">
      <!-- <button
        id="theme-toggle"
        class="theme-toggle"
        aria-label={t("theme.toggle")}
        aria-pressed="false"
      >
        <svg
          class="icon-sun"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
          ></path>
        </svg>
        <svg
          class="icon-moon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
        </svg>
      </button> -->

      <button
        class="hamburger"
        id="hamburger-btn"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-menu" id="mobile-menu">
    {
      links.map((l) => (
        <a href={l.href} class={l.key === page ? "mobile-cta" : ""}>
          {l.label}
        </a>
      ))
    }
    <div class="mobile-locale-switcher">
      <div class="locale-pill">
        {
          localeList.map((l) =>
            l === lang ? (
              <span class="locale-active">{l}</span>
            ) : (
              <a href={getAlternatePath(Astro.url, lang, l)}>{l}</a>
            )
          )
        }
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById("hamburger-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    const open = btn.classList.toggle("open");
    menu?.classList.toggle("open");
    btn.setAttribute("aria-expanded", String(open));
  });

  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      btn?.classList.remove("open");
      menu.classList.remove("open");
      btn?.setAttribute("aria-expanded", "false");
    })
  );

  const themeToggle = document.getElementById("theme-toggle");
  themeToggle?.addEventListener("click", () => {
    const isLight = document.documentElement.dataset.theme === "light";
    const next = isLight ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
    themeToggle.setAttribute("aria-pressed", String(next === "light"));
  });

  if (themeToggle) {
    themeToggle.setAttribute(
      "aria-pressed",
      String(document.documentElement.dataset.theme === "light")
    );
  }
</script>
